# GEMINI_API_KEY: Gemini API дуудлагад шаардлагатай.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Апп байршиж буй хаяг (OAuth callback-д ашиглана). Жишээ: https://female-or-male.vercel.app
APP_URL="MY_APP_URL"

# --- Discord нэвтрэлт ---
# Discord Developer Portal → OAuth2 хэсгээс авна. Redirect: APP_URL + /api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Owner-ийн Discord ID (Discord → Settings → Advanced → Developer Mode асаагаад профайл дээр баруун товшиж "Copy User ID").
# Хэд байвал таслалаар тусгаарлана.
OWNER_DISCORD_ID=""

# Session-д гарын үсэг зурах нууц түлхүүр. Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Төлбөрийн мэдэгдэл (заавал биш) ---
DISCORD_WEBHOOK_URL=""
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
